# WI-20261010-ATS-013: UNRENDERED / NOT INSTALLED. No installation section.
[Unit]
Description=ATStudio explicitly authorized recurring cold capture
ConditionPathExists=/etc/atstudio-backup/EXECUTION-APPROVED

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/atstudio-backup/scheduled_dispatch.py --execute --config /etc/atstudio-backup/config.json --policy /etc/atstudio-backup/recurring-policy.json --budget /etc/atstudio-backup/recurring-budget.json --pins /etc/atstudio-backup/run-pins.json --manifest /etc/atstudio-backup/run-manifest.json --state /var/lib/atstudio-backup/state/scheduled-ledger
MemoryAccounting=true
MemoryHigh=768M
MemoryMax=1G
MemorySwapMax=0
CPUQuota=100%
Nice=10
TasksMax=32
LimitNOFILE=1024
LimitCORE=0
KillMode=control-group
RuntimeMaxSec=1080s
TimeoutStartSec=1080s
TimeoutStopSec=35s
SendSIGKILL=yes
Restart=no
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=null
