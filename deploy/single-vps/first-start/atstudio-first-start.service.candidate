# WI-20261011-ATS-017: NOT INSTALLED / NOT ENABLED / NOT AN OPERATOR.
# Keep the false gate until a separately approved, reviewed target-proof step exists.
[Unit]
Description=ATStudio bounded private first-start candidate (HOLD)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=1

[Service]
Type=simple
User=atstudio
Group=atstudio
WorkingDirectory=/opt/atstudio
EnvironmentFile=/etc/atstudio/__EXISTING_APPROVED_PRIVATE_ENV__
EnvironmentFile=/etc/atstudio/first-start-public.env
UnsetEnvironment=JAVA_TOOL_OPTIONS JDK_JAVA_OPTIONS _JAVA_OPTIONS LD_PRELOAD LD_LIBRARY_PATH SPRING_APPLICATION_JSON SPRING_CONFIG_ADDITIONAL_LOCATION SPRING_CONFIG_IMPORT SPRING_PROFILES_INCLUDE HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy GOOGLE_CLIENT_ID GOOGLE_CLIENT_SECRET KAKAO_CLIENT_ID KAKAO_CLIENT_SECRET NAVER_CLIENT_ID NAVER_CLIENT_SECRET TOSS_CLIENT_KEY TOSS_SECRET_KEY MAIL_USERNAME MAIL_PASSWORD
ExecStartPre=/usr/bin/false
ExecStart=/usr/bin/java -Xms256m -Xmx1024m -XX:MaxMetaspaceSize=256m -XX:+ExitOnOutOfMemoryError -Djava.io.tmpdir=/var/lib/atstudio/tmp -Duser.timezone=Asia/Seoul -jar __APP_JAR__ \
    --spring.config.location=classpath:/application.yml \
    --spring.config.additional-location= \
    --spring.config.import= \
    --spring.profiles.active=prod \
    --spring.profiles.include= \
    --server.address=127.0.0.1 \
    --server.port=8080 \
    --server.forward-headers-strategy=none \
    --server.tomcat.accesslog.enabled=false \
    --app.background-tasks.enabled=false \
    --app.audio.worker-enabled=false \
    --app.auth.password-login.enabled=false \
    --app.acceptance.enabled=false \
    --app.bootstrap.test-users.enabled=false \
    --app.bootstrap.test-users.default-password= \
    --app.payment.operations.reconciliation-notification-enabled=false \
    --app.payment.operations.operator-email= \
    --spring.sql.init.mode=never \
    --spring.jpa.hibernate.ddl-auto=validate \
    --spring.jpa.show-sql=false \
    --app.storage.require-explicit-roots=true \
    --app.storage.public-path=/srv/atstudio/public \
    --app.storage.private-path=/srv/atstudio/private \
    --app.storage.integrity.audit-on-startup=true \
    --app.storage.integrity.strict-on-startup=true \
    --app.storage.mutation-admission.enabled=true \
    --app.storage.mutation-admission.max-concurrent=2 \
    --app.storage.mutation-admission.max-concurrent-per-ip=1 \
    --app.storage.mutation-admission.retry-after-seconds=2 \
    --app.security.rate-limit.enabled=true \
    --app.security.trusted-client-identity.enabled=false \
    --spring.datasource.hikari.maximum-pool-size=10 \
    --spring.datasource.hikari.minimum-idle=2 \
    --spring.datasource.hikari.connection-timeout=5000 \
    --spring.servlet.multipart.location=/var/lib/atstudio/tmp \
    --spring.servlet.multipart.file-size-threshold=0B \
    --spring.mail.host=127.0.0.1 \
    --spring.mail.port=1 \
    --spring.mail.username= \
    --spring.mail.password= \
    --spring.mail.test-connection=false \
    --spring.mail.properties.mail.smtp.auth=false \
    --spring.mail.properties.mail.smtp.starttls.enable=false \
    --app.mail.from=disabled@example.invalid \
    --oauth2.google.client-id= \
    --oauth2.google.client-secret= \
    --oauth2.kakao.client-id= \
    --oauth2.kakao.client-secret= \
    --oauth2.naver.client-id= \
    --oauth2.naver.client-secret= \
    --app.payment.toss.client-key= \
    --app.payment.toss.secret-key= \
    --springdoc.api-docs.enabled=false \
    --springdoc.swagger-ui.enabled=false \
    --spring.mvc.log-request-details=false \
    --logging.level.org.hibernate.SQL=off \
    --logging.level.org.hibernate.orm.jdbc.bind=off
Restart=no
RuntimeMaxSec=180s
RuntimeRandomizedExtraSec=0
TimeoutStartSec=30s
TimeoutStopSec=30s
KillMode=control-group
SendSIGKILL=yes
UMask=0077
LimitCORE=0
LimitNOFILE=4096
TasksMax=256
MemoryHigh=2G
MemoryMax=3G
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadOnlyPaths=/opt/atstudio
ReadWritePaths=/srv/atstudio/public /srv/atstudio/private /var/lib/atstudio/tmp
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32 ::1/128
StandardOutput=journal
StandardError=journal
SyslogIdentifier=atstudio-first-start
# Deliberately no [Install], WantedBy, Requires=mysql, or Nginx dependency.
