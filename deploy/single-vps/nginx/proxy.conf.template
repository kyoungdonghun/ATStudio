# Location snippet. No URI suffix, rewrite, or upstream retry.
proxy_pass http://127.0.0.1:8080;
proxy_http_version 1.1;
proxy_next_upstream off;
proxy_intercept_errors off;
proxy_redirect off;

# Allowlist instead of a partial Forwarded/X-Forwarded-* denylist.
# Body framing is still generated by nginx; do not copy Content-Length manually.
proxy_pass_request_headers off;
proxy_set_header Host __APP_FQDN__;
proxy_set_header Connection "";
proxy_set_header X-ATStudio-Client-IP $remote_addr;
proxy_set_header Authorization $http_authorization;
proxy_set_header Content-Type $http_content_type;
proxy_set_header Accept $http_accept;
proxy_set_header Accept-Language $http_accept_language;
proxy_set_header Origin $http_origin;
proxy_set_header Access-Control-Request-Method $http_access_control_request_method;
proxy_set_header Access-Control-Request-Headers $http_access_control_request_headers;
proxy_set_header Idempotency-Key $http_idempotency_key;
proxy_set_header Range $http_range;
proxy_set_header If-Range $http_if_range;
proxy_set_header If-None-Match $http_if_none_match;
proxy_set_header If-Modified-Since $http_if_modified_since;
proxy_set_header If-Match $http_if_match;
proxy_set_header If-Unmodified-Since $http_if_unmodified_since;

proxy_cache off;
proxy_store off;
proxy_buffering off;
proxy_max_temp_file_size 0;
proxy_request_buffering off;
proxy_ignore_headers X-Accel-Redirect X-Accel-Buffering;
proxy_connect_timeout 5s;
proxy_read_timeout 360s;
proxy_send_timeout 60s;
limit_req zone=ats_api burst=40 nodelay;
